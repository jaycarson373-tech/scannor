# Copy to .env for local runs (never commit .env). In GitHub: Settings > Secrets and variables > Actions.

# Claude writes the beta plays. Without it you still get rule-based culture ideas.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5) and how often to call it.
SCANNOR_MODEL=
SCANNOR_CLAUDE_EVERY_MIN=30

# Alerts: Telegram (bot from @BotFather + your chat id) and/or a Discord webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Score (0-100) an open idea needs before it pings you.
SCANNOR_ALERT_SCORE=60
# Linked at the bottom of every alert.
SCANNOR_DASHBOARD_URL=
